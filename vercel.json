{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build --workspace=frontend",
  "outputDirectory": "frontend/.next",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/membership-expiry",
      "schedule": "30 2 * * *"
    }
  ]
}
