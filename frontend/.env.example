# ==============================================================================
# MuscleCraft Fitness Platform — Production Environment Variables Template
# Copy to `.env.local` for local development or configure in Vercel Dashboard.
# NEVER commit `.env.local` or real secret keys to Git!
# ==============================================================================

# 1. Public Application URL (used for SEO canonicals, sitemaps, and email links)
NEXT_PUBLIC_APP_URL=https://www.musclecraftlk.com

# 2. Supabase Cloud PostgreSQL & Authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here

# 3. Resend Email Service (Sending & Receiving)
# Create API key in Resend Dashboard -> API Keys (ensure DNS domain is verified)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="MuscleCraft <admin@musclecraftlk.com>"
RESEND_ADMIN_EMAIL=admin@musclecraftlk.com
RESEND_REPLY_TO=admin@musclecraftlk.com
# Optional Svix signing secret from Resend -> Webhooks -> email.received (whsec_...)
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# 4. Text.lk SMS Gateway (Sri Lanka)
TEXTLK_API_TOKEN=your_textlk_api_token_here
TEXTLK_SENDER_ID=Musclecraft

# 5. Cloudflare R2 Object Storage (Optional — Video Vault CDN)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=musclecraft-videos
R2_PUBLIC_DOMAIN=

# 6. Vercel Cron Security Secret (Optional — protects /api/cron/membership-expiry)
CRON_SECRET=your_random_cron_secret_here
