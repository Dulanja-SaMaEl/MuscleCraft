# Frontend Environment Variables (Vercel / Local Next.js)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# Supabase Project URL (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# You can use EITHER the new Publishable Key OR the legacy Anon Key:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sbp_your_publishable_key_here"
# or
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# WhatsApp Business / Head Coach Contact
NEXT_PUBLIC_WHATSAPP_NUMBER="94771234567"
