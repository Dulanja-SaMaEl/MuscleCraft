# ==============================================================================
# MuscleCraft Production Environment Variables (Vercel / Railway / Node.js)
# ==============================================================================

# 1. Supabase Project REST API URL (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_URL="https://your-project-ref.supabase.co"

# 2. Supabase API Key (Client / Public - use Publishable Key OR legacy Anon Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# or if using the new Supabase publishable key format:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sbp_your_publishable_key_here"

# 3. Supabase Service Role Secret Key (Server routes - bypasses RLS for admin operations)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 4. Optional Direct Database Connection String (Transaction Pooler or Direct)
# If provided, the app will automatically parse your Supabase project ref!
# DATABASE_URL="postgresql://postgres.your-project-ref:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# 5. Public URLs & Contact
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="94771234567"
