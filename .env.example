# ============================================================================
# MuscleCraft Fitness Platform — Environment Variables
# Supports both New Supabase Keys (Publishable / Secret) and Legacy Keys (Anon / Service Role)
# ============================================================================

# Application URLs
PORT=3000
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_API_BASE_URL="https://your-backend.onrender.com"

# Supabase Project URL (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# --- Option A: NEW Supabase Keys ---
# Publishable key (Client-side): starts with sbp_ or similar
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sbp_your_publishable_key_here"
# Secret key (Server-side / Backend): starts with sbs_ or similar
SUPABASE_SECRET_KEY="sbs_your_secret_key_here"

# --- Option B: LEGACY Supabase Keys (Available via "View legacy API keys" button) ---
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Database Direct URL
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# WhatsApp Business / Head Coach Contact
NEXT_PUBLIC_WHATSAPP_NUMBER="94771234567"
