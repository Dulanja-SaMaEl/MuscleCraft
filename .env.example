# IronForge Environment Variables Template
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_URL="postgresql://postgres:password@localhost:5432/ironforge"

# Cloudflare Stream Video
CLOUDFLARE_ACCOUNT_ID="your-cf-account-id"
CLOUDFLARE_STREAM_API_TOKEN="your-cf-stream-token"
NEXT_PUBLIC_CLOUDFLARE_STREAM_DOMAIN="https://customer-xyz.cloudflarestream.com"
