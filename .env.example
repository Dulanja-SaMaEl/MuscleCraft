# ============================================================================
# MuscleCraft Fitness Platform — Environment Variables
# Use these in Vercel (Frontend) and Render (Backend)
# ============================================================================

# Application URLs
PORT=3000
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_API_BASE_URL="https://your-backend.onrender.com"

# Supabase PostgreSQL Configuration (Project Settings -> API & Database)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# WhatsApp Business / Head Coach Contact
NEXT_PUBLIC_WHATSAPP_NUMBER="94771234567"

# Cloudflare Stream Video (Optional / Production Video Hosting)
CLOUDFLARE_ACCOUNT_ID="your-cf-account-id"
CLOUDFLARE_STREAM_API_TOKEN="your-cf-stream-token"
NEXT_PUBLIC_CLOUDFLARE_STREAM_DOMAIN="https://customer-xyz.cloudflarestream.com"
